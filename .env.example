VITE_API_BASE_URL=http://localhost:5000/api
# files = public/map-layers on disk (default) | mock = IndexedDB | api = real backend
# With `files`, each developer uploads KMZ locally (Layer panel). Uploads are gitignored.
VITE_MAP_LAYER_STORAGE=files
# Satellite basemap token (ArcGIS Location Platform). Leave empty to use OSM fallback.
VITE_ARCGIS_API_KEY=
