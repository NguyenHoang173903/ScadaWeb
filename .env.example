VITE_API_BASE_URL=http://localhost:5140/api/v1
# files = public/map-layers on disk (default) | mock = IndexedDB | api = BE /api/v1/map-layers
# With `api`, cần đăng nhập JWT; upload/patch/delete yêu cầu Admin.
# With `files`, each developer uploads KMZ locally (Layer panel). Uploads are gitignored.
VITE_MAP_LAYER_STORAGE=files
# Satellite basemap token (ArcGIS Location Platform). Leave empty to use OSM fallback.
VITE_ARCGIS_API_KEY=
